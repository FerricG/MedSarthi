# MedSarthi Environment Configuration (Educational Prototype - Synthetic Data Only)
# Copy this file to .env (or backend/.env) and fill in optional AI provider keys.
# NEVER commit real .env files or hardcode API keys.

APP_NAME=MedSarthi
APP_ENV=development
DEBUG=true
SYNTHETIC_PROTOTYPE_MODE=true

# Database (SQLite with WAL + Foreign Keys enabled locally)
DATABASE_URL=sqlite+aiosqlite:///./medsarthi.db

# Security & Auth (Change JWT_SECRET_KEY before any non-local deployment)
JWT_SECRET_KEY=dev-only-change-me-to-a-64-char-random-secret-key-medsarthi-2026
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
COOKIE_SECURE=false

# CORS & Frontend
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local Private File & Ephemeral Audio Storage
STORAGE_LOCAL_DIR=./storage
AUDIO_DEFAULT_RETENTION_HOURS=24

# AI Provider Selection & Privacy/Safety Guards (Zero-Training & Synthetic Prototype Gates)
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_ALLOW_UNPAID_TRAINING_TIER=false
GROQ_ZDR_VERIFIED=false

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OCR & Speech Providers
OCR_PRIMARY_PROVIDER=pymupdf_rapidocr
OCR_FALLBACK_PROVIDER=google_vision
GOOGLE_CLOUD_VISION_API_KEY=
GCV_ENDPOINT=https://us-vision.googleapis.com
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
AZURE_DOC_INTEL_F0_MODE=true

STT_PRIMARY_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MIP_OPT_OUT=true

TTS_PRIMARY_PROVIDER=azure_speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_ALLOW_UNOFFICIAL_EDGE=false
TRANSLATION_PROVIDER=llm
